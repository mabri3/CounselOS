    </script><script nonce="nxwR46wPkaFkwADhEQPkVSdq">
(function () {

  // --- URL guard (only run on this exact blog page) ---
  const ALLOWED_PATH = "/blogs/a-year-in-data-kyc-aml-and-onboarding-in-2023";
  if (
    window.location.hostname !== "resources.fenergo.com" ||
    window.location.pathname.replace(/\/$/, "") !== ALLOWED_PATH
  ) {
    return;
  }

  const IMAGE_URL = "https://cdn.prod.website-files.com/649bda80099ef51a3cc09f8a/691609c621971dff8d839e6c_Social-Graphic-Reg-Horizon-Scanning-Webinar.png";

  const SETTINGS = {
    hideForDaysAfterClose: 30,
    zIndex: 9999,
    fontHref: "https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap",
    ctaBg: "#2F4258",   // navy color from your sample
    ctaText: "#ffffff",
    textSize: "14.4px",
    cardWidth: 379,
    delayMs: 3000      // ⏱ wait 10 seconds after marker is detected
  };

  const COPY = "In 2026, the compliance map is being redrawn. Global regimes are set to sharpen, demanding that financial institutions demonstrate faster controls, harder proofs, and cleaner data to global regulators.\u200B\n\nJoin this deep-dive webinar session where regulatory and financial crime experts from Fenergo will discuss what’s on the horizon — and what your organization should already be preparing for.";

  const CTA = {
    text: "Register now",
    href: "https://www.fenergo.com/webinar/regulatory-horizon-scanning-2026-clarifying-the-complexity?utm_source=website&utm_medium=pop-up&utm_campaign=reg-horizon-scanning"
  };

  // --- suppression ---
  const SUP_KEY = "fngPopupDismissed_v10";
  const day = 86400000, now = () => Date.now();
  const isSuppressed = () => {
    try {
      const t = localStorage.getItem(SUP_KEY);
      if (t && now() - +t < SETTINGS.hideForDaysAfterClose * day) return true;
    } catch {}
    return document.cookie.includes(SUP_KEY + "=1");
  };
  const setSuppressed = () => {
    try { localStorage.setItem(SUP_KEY, String(now())); } catch {}
    document.cookie = `${SUP_KEY}=1; path=/; expires=${new Date(now()+SETTINGS.hideForDaysAfterClose*day).toUTCString()}; SameSite=Lax`;
  };
  if (isSuppressed()) return;

  // --- font load once ---
  if (!document.querySelector('link[data-fng-font="poppins"]')) {
    const l = document.createElement("link");
    l.rel = "stylesheet";
    l.href = SETTINGS.fontHref;
    l.setAttribute("data-fng-font","poppins");
    document.head.appendChild(l);
  }

  // --- Observe DOM for Webeo marker ---
  function checkForMarker() {
    return document.querySelector('#webeo-marker[data-webeo-campaign="5"]');
  }

  function onMarkerDetected() {
    // Wait before showing popup
    setTimeout(showPopup, SETTINGS.delayMs);
  }

  if (checkForMarker()) {
    onMarkerDetected();
  } else {
    const obs = new MutationObserver(() => {
      if (checkForMarker()) {
        obs.disconnect();
        onMarkerDetected();
      }
    });
    obs.observe(document.documentElement || document.body, { childList: true, subtree: true });
  }

  function showPopup() {
    injectStyles();
    const wrap = build();
    hookInteractions(wrap, setSuppressed);

    const card = wrap.querySelector(".card");
    const applyWidth = () => {
      const w = Math.min(SETTINGS.cardWidth, window.innerWidth - 24);
      card.style.width = w + "px";
    };
    applyWidth();
    window.addEventListener("resize", applyWidth);

    requestAnimationFrame(() => wrap.classList.add("show"));
  }

  function injectStyles(){
    const css = `
      #fng-popup{ position:fixed; left:16px; bottom:16px; z-index:${SETTINGS.zIndex};
        display:block; font-family:'Poppins', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      }
      @media (max-width:640px){ #fng-popup{ left:12px; right:12px; bottom:12px; } }
      #fng-popup .card{
        display:inline-block;
        max-width:calc(100vw - 24px);
        background:#fff; color:#111; border-radius:16px; overflow:hidden;
        box-shadow:0 12px 30px rgba(0,0,0,.18);
        transform:translateY(8px); opacity:0; transition:all .25s ease;
      }
      #fng-popup.show .card{ transform:translateY(0); opacity:1; }
      #fng-popup .head{ position:relative; line-height:0; }
      #fng-popup img{ display:block; width:100%; height:auto; }
      #fng-popup .body{ padding:16px 16px 14px; }
      #fng-popup .text{
        margin:0 0 14px 0;
        font-size:${SETTINGS.textSize};
        line-height:1.55;
        white-space:pre-wrap;
      }
      #fng-popup .cta{
        display:block;
        width:100%;
        text-align:center;
        text-decoration:none;
        font-size:${SETTINGS.textSize};
        line-height:1.4;
        padding:10px 0;
        border-radius:999px;
        font-weight:500;
        background:${SETTINGS.ctaBg};
        color:${SETTINGS.ctaText};
      }
      #fng-popup .cta:hover{ opacity:0.9; }
      #fng-popup .close{
        position:absolute; top:10px; right:10px; width:28px; height:28px;
        display:grid; place-items:center; border:0; border-radius:999px;
        background:rgba(0,0,0,.06); cursor:pointer; font-size:14px;
      }
      #fng-popup .close:focus{ outline:2px solid ${SETTINGS.ctaBg}; outline-offset:2px; }
    `;
    const style = document.createElement("style");
    style.textContent = css;
    document.head.appendChild(style);
  }

  function build(){
    const wrap = document.createElement("div");
    wrap.id = "fng-popup";
    wrap.setAttribute("aria-live","polite");
    wrap.innerHTML = `
      <section class="card" role="dialog" aria-modal="false" aria-label="Promotion">
        <div class="head">
          <button class="close" aria-label="Close promotion" data-close>×</button>
          <img src="${IMAGE_URL}" alt="Regulatory Horizon Scanning 2026 Webinar">
        </div>
        <div class="body">
          <p class="text">${COPY}</p>
          <a class="cta" href="${CTA.href}" target="_blank" rel="noopener">${CTA.text}</a>
        </div>
      </section>
    `;
    document.body.appendChild(wrap);
    return wrap;
  }

  function hookInteractions(wrap, setSuppressed){
    const close = () => { setSuppressed(); wrap.remove(); };
    wrap.querySelector("[data-close]").addEventListener("click", close);
    wrap.querySelector(".cta").addEventListener("click", () => setSuppressed());
  }

})();
</script>

    
