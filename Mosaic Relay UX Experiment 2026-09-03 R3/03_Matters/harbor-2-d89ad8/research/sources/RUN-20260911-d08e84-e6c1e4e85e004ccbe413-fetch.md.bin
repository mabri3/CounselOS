	<article  data-qa="exclude" class="post-5725 post type-post status-publish format-standard has-post-thumbnail hentry category-bank-regulatory lxb_af-post lxb_af-grid-box-constrained lxb_af-post-first lxb_af-not_card lxb_af-grid-not-magazine-cell">
 		
 		<header role="presentation" class="lxb_af-post_header lxb_af-grid-parade">

 			
						
			<h1 class='lxb_af-template_tags-get_post_title'>OCC Confirms National Bank Act Preempts State Money Transmitter Licensing for Fidelity Digital Assets</h1>
							
			<figure class='lxb_af-featured_image-get lxb_af-grid-width-1_of_1 lxb_af-x_landscape lxb_af-featured_image-get-no_caption lxb_af-grid-align-top lxb_af-featured_image-get-big_enough' style='max-width: ;'>
