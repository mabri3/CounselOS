guide-to-investing-in-ucits-etfs-to-avoid-pfic\",{\"className\":\"relative group bg-white rounded-2xl transition-all duration-300 overflow-hidden border border-slate-200 hover:border-slate-300 hover:shadow-lg hover:-translate-y-1 flex flex-col h-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"h-40 w-full overflow-hidden relative bg-background-default\",\"children\":[\"$\",\"$L2d\",null,{\"src\":\"/generated/blog-diagrams/1023-us-expat-guide-to-investing-in-ucits-etfs-to-avoid-pfic-tier-2-the-core-portfolio-decision-matrix-calculated-complexity-for--2c05cb187699.png\",\"alt\":\"A US Expat's Guide to Investing in UCITS ETFs to Avoid PFIC Issues\",\"fill\":true,\"className\":\"object-contain\",\"sizes\":\"(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 100vw\"}]}],[\"$\",\"div\",null,{\"className\":\"p-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between mb-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-teal-600 bg-teal-50 px-2 py-1 rounded\",\"children\":\"Professional Deep Dives\"}],[\"$\",\"span\",null,{\"className\":\"text-sm text-slate-500\",\"children\":[15,\" min read\"]}]]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-bold text-slate-900 mb-2 group-hover:text-brand-primary transition-colors line-clamp-2\",\"children\":[\"$\",\"$L18\",null,{\"href\":\"/blog/us-expat-guide-to-investing-in-ucits-etfs-to-avoid-pfic\",\"prefetch\":false,\"className\":\"after:absolute after:inset-0\",\"children\":\"A US Expat's Guide to Investing in UCITS ETFs to Avoid PFIC Issues\"}]}],[\"$\",\"p\",null,{\"className\":\"text-slate-600 text-sm mb-6 flex-grow line-clamp-3 leading-relaxed\",\"children\":\"The real problem is a two-system conflict. U.S. tax treatment can punish the wrong fund choice, while local product-access constraints can block the funds you want to buy in the first place. For **us expat ucits etfs**, the practical question is not \\\"Which product is best?\\\" It is \\\"What can I access, report, and keep doing every year without guessing?\\\" Use this four-part filter before any trade:\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between pt-4 border-t border-slate-50 mt-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"ucits etfs\",{\"className\":\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-full hover:bg-slate-200 transition-colors\",\"children\":\"ucits etfs\"}],[\"$\",\"span\",\"pfic\",{\"className\":\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-full hover:bg-slate-200 transition-colors\",\"children\":\"pfic\"}],[\"$\",\"span\",\"us expat investing\",{\"className\":\"text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-full hover:bg-slate-200 transition-colors\",\"children\":\"us expat investing\"}]]}],[\"$\",\"span\",null,{\"className\":\"text-brand-primary text-sm font-bold transition-colors flex items-center\",\"children\":[\"Read\",[\"$\",\"svg\",null,{\"className\":\"ml-1 h-3.5 w-3.5 transform transition-transform group-hover:translate-x-1\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"strokeWidth\":2,\"d\":\"M14 5l7 7m0 0l-7 7m7-7H3\"}]}]]}]]}]]}]]}]\n"])</script><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"f69c52f02f08498ea59fc51ccef401dc","spa":2}' crossorigin="anonymous"></script>
