these columns:\"}]\n"])</script><script>self.__next_f.push([1,"60:[\"$\",\"$Le7\",\"table-2\",{\"children\":[[\"$\",\"thead\",\"thead-0\",{\"children\":[\"$\",\"tr\",\"tr-0\",{\"children\":[[\"$\",\"th\",\"th-0\",{\"children\":\"Market / vertical\",\"className\":\"\"}],[\"$\",\"th\",\"th-1\",{\"children\":\"Compliance evidence\",\"className\":\"\"}],[\"$\",\"th\",\"th-2\",{\"children\":\"Technical and operational fit\",\"className\":\"\"}],[\"$\",\"th\",\"th-3\",{\"children\":\"Financial evidence\",\"className\":\"\"}],[\"$\",\"th\",\"th-4\",{\"children\":\"Diligence confidence\",\"className\":\"\"}]]}]}],[\"$\",\"tbody\",\"tbody-0\",{\"children\":[\"$\",\"tr\",\"tr-0\",{\"children\":[[\"$\",\"td\",\"td-0\",{\"children\":\"[Market / Vertical]\",\"className\":\"\"}],[\"$\",\"td\",\"td-1\",{\"children\":[\"Required controls/policies for this market; payment-specific gates marked \",[\"$\",\"code\",\"code-0\",{\"className\":\"bg-slate-100 px-1 rounded text-sm\",\"node\":{\"type\":\"element\",\"tagName\":\"code\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"unknown\",\"position\":{\"start\":{\"line\":102,\"column\":99,\"offset\":8117},\"end\":{\"line\":102,\"column\":108,\"offset\":8126}}}],\"position\":{\"start\":{\"line\":102,\"column\":99,\"offset\":8117},\"end\":{\"line\":102,\"column\":108,\"offset\":8126}}},\"children\":\"unknown\"}],\" until documented\"],\"className\":\"\"}],[\"$\",\"td\",\"td-2\",{\"children\":[\"Due-diligence activities completed (\",[\"$\",\"code\",\"code-0\",{\"className\":\"bg-slate-100 px-1 rounded text-sm\",\"node\":{\"type\":\"element\",\"tagName\":\"code\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"site visits\",\"position\":{\"start\":{\"line\":102,\"column\":164,\"offset\":8182},\"end\":{\"line\":102,\"column\":177,\"offset\":8195}}}],\"position\":{\"start\":{\"line\":102,\"column\":164,\"offset\":8182},\"end\":{\"line\":102,\"column\":177,\"offset\":8195}}},\"children\":\"site visits\"}],\", \",[