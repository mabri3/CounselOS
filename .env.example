# Application
APP_NAME=Counsel OS
FRONTEND_ORIGIN=http://localhost:3000
VAULT_PATH=./vault

# Model provider: mock | openai_compatible
LLM_PROVIDER=mock
LLM_PROVIDER_LABEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional for models that accept an OpenAI-style reasoning_effort value.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=120
MAX_AGENT_STEPS=6

# Optional general web search for research: disabled | tavily
SEARCH_PROVIDER=disabled
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=6

# Local scheduler
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=5
DECISION_REVIEW_AGE_DAYS=180

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=Counsel OS
MAX_UPLOAD_MB=25
