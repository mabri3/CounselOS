# Application
APP_NAME=Counsel OS
FRONTEND_ORIGIN=http://localhost:3000
VAULT_PATH=./vault

# Workspace-default model provider. Agent files can override this with:
# mock | openai_compatible | opencode_go | codex | antigravity_cli
LLM_PROVIDER=mock
LLM_PROVIDER_LABEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# OpenCode Go accepts either name. OPENCODE_GO_API_KEY takes precedence.
OPENCODE_GO_API_KEY=
OPENCODE_API_KEY=
LLM_MODEL=
# Optional for models that accept an OpenAI-style reasoning_effort value.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=120
DOSSIER_TIMEOUT_SECONDS=300
MAX_AGENT_STEPS=6

# Optional general web search for research: disabled | tavily | firecrawl
SEARCH_PROVIDER=disabled
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=6

# Optional external legal-intelligence provider. The key stays in the environment.
POLARIS_API_KEY=

# Fixed external collection safety limits
INTELLIGENCE_REQUEST_TIMEOUT_SECONDS=15
INTELLIGENCE_RUN_TIMEOUT_SECONDS=60
INTELLIGENCE_MAX_REDIRECTS=3
INTELLIGENCE_MAX_COMPRESSED_BYTES=2097152
INTELLIGENCE_MAX_DECOMPRESSED_BYTES=5242880
INTELLIGENCE_MAX_EXCERPT_CHARACTERS=12000
INTELLIGENCE_MAX_DISCOVERY_URLS=50
INTELLIGENCE_MAX_CANDIDATES=100

# Local scheduler
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=5
DECISION_REVIEW_AGE_DAYS=180

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=Counsel OS
# Developer-only: show saved agent tool traces inside chat.
NEXT_PUBLIC_SHOW_AGENT_TRACES=false
MAX_UPLOAD_MB=25
