height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) --><style>
  /* ── H2 Section Headings ── */
  .w-richtext h2 {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #E2E0DB;
  }

  /* ── H3 Subheadings ── */
  .w-richtext h3 {
    font-size: 1.1rem;
    color: #236B7D;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.01em;
  }

  /* ── Ordered Lists (Key Elements) ── */
  .w-richtext ol li {
    padding: 0.35rem 0;
    line-height: 1.7;
  }

  .w-richtext ol li strong:first-child {
    color: #1a1a1a;
  }

  /* ── Tier Cards (Where Does Your Clause Fall?) ── */
  .tier-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 1.5rem;
  }

  .tier-list li {
    background: #FAFAF8;
    border: 1px solid #E8E7E3;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 0.5rem;
    font-size: 14.5px;
    line-height: 1.65;
  }

  .tier-list li strong:first-child {
    color: #236B7D;
  }

  /* ── Market Data List ── */
  .market-data-list {
    background: #F8F7F5;
    border-radius: 8px;
    padding: 1rem 1.25rem 1rem 2.25rem;
    margin: 0.75rem 0 1.5rem;
    list-style: none;
  }

  .market-data-list li {
    position: relative;
    padding: 0.4rem 0;
    font-size: 14.5px;
    line-height: 1.65;
    border-bottom: 1px solid #EEEDEA;
  }

  .market-data-list li:last-child {
    border-bottom: none;
  }

  .market-data-list li::before {
    content: '\1F4CA';
    position: absolute;
    left: -1.75rem;
    font-size: 13px;
  }

  /* ── Playbook Lists ── */
  .drafting-notes li::marker { content: '\2713  '; color: #236B7D; font-weight: 700; }
  .common-pitfalls li::marker { content: '\26A0  '; color: #C4722A; }

  .drafting-notes li,
  .common-pitfalls li {
    padding: 0.3rem 0;
    line-height: 1.7;
  }
  </style>

  <script>
  document.addEventListener('DOMContentLoaded', function() {

    /* ── TL;DR Box ── */
    document.querySelectorAll('.w-richtext p').forEach(function(p) {
      if (p.innerText.trim().startsWith('TL;DR')) {
        var box = document.createElement('div');
        box.className = 'tldr-box';
        box.innerHTML = p.innerHTML.replace(/^TL;DR[\s:–\-]*(<br\s*\/?>)?\s*/i, '');
        p.replaceWith(box);
      }
    });

    /* ── Sample Clause Copy Buttons ── */
    document.querySelectorAll('.w-richtext blockquote').forEach(function(bq) {
      var btn = document.createElement('button');
      btn.textContent = 'Copy sample clause';
      btn.className = 'copy-clause-btn';
      btn.addEventListener('click', function() {
        navigator.clipboard.writeText(bq.innerText.trim()).then(function() {
          btn.textContent = 'Copied!';
          btn.style.background = '#236B7D';
          btn.style.color = '#fff';
          setTimeout(function() {
            btn.textContent = 'Copy sample clause';
            btn.style.background = '#CEE2E4';
            btn.style.color = '#236B7D';
          }, 2000);
        });
      });
      bq.insertAdjacentElement('afterend', btn);
    });

    /* ── Auto-classify H3 sibling lists ── */
    document.querySelectorAll('.w-richtext h3').forEach(function(h3) {
      var text = h3.textContent.trim();
      var ul = h3.nextElementSibling;
      if (!ul || ul.tagName !== 'UL') return;

      if (text.indexOf('Where Does Your Clause Fall') !== -1) {
        ul.classList.add('tier-list');
      } else if (text === 'Market Data') {
        ul.classList.add('market-data-list');
      } else if (text === 'Key Drafting Notes') {
        ul.classList.add('drafting-notes');
      } else if (text === 'Common Pitfalls') {
        ul.classList.add('common-pitfalls');
      }
    });

  });
  </script><script src="https://cdn.prod.website-files.com/637d1184b6b77204d212405c%2F689e5ba67671442434f3ca35%2F69dd2c28abf0ca910621f1d0%2Fjsonlddedupfix-1.0.0.js" type="text/javascript"></script></body></html>