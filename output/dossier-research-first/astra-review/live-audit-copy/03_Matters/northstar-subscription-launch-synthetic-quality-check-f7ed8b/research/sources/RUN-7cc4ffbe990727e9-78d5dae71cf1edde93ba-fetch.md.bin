ityId\":258311,\"image\":{\"src\":\"https://s3-us-west-2.amazonaws.com/videostorage-us-west/videos/901e155902b4ef0418c5e7a4d31dc7f5/thumbnails/large.jpg\",\"alt\":\"Assembly Floor\"},\"timestamp\":1702,\"title\":\"Assembly Floor\",\"videoLength\":105,\"fileId\":\"901e155902b4ef0418c5e7a4d31dc7f5\"},{\"date\":\"2024-08-27\",\"entityId\":258298,\"image\":{\"src\":\"https://s3-us-west-2.amazonaws.com/videostorage-us-west/videos/055d13d671bd2113d9fda89609dd2256/thumbnails/large.jpg\",\"alt\":\"Senate Floor\"},\"timestamp\":0,\"title\":\"Senate Floor\",\"videoLength\":236,\"fileId\":\"055d13d671bd2113d9fda89609dd2256\"},{\"date\":\"2024-06-25\",\"entityId\":258093,\"image\":{\"src\":\"https://s3-us-west-2.amazonaws.com/videostorage-us-west/videos/b11601742856bf919b3c88dfad833abd/thumbnails/large.jpg\",\"alt\":\"Senate Standing Committee on Judiciary\"},\"timestamp\":0,\"title\":\"Senate Standing Committee on Judiciary\",\"videoLength\":1234,\"fileId\":\"b11601742856bf919b3c88dfad833abd\"},{\"date\":\"2024-05-16\",\"entityId\":257965,\"image\":{\"src\":\"https://s3-us-west-2.amazonaws.com/videostorage-us-west/videos/bc9c4d6a18741516891ef7d68d00b250/thumbnails/large.jpg\",\"alt\":\"Assembly Floor\"},\"timestamp\":1370,\"title\":\"Assembly Floor\",\"videoLength\":211,\"fileId\":\"bc9c4d6a18741516891ef7d68d00b250\"},{\"date\":\"2024-04-30\",\"entityId\":257881,\"image\":{\"src\":\"https://s3-us-west-2.amazonaws.com/videostorage-us-west/videos/5d27e1327cb64797d633226e394ea5f9/thumbnails/large.jpg\",\"alt\":\"Assembly Standing Committee on Privacy and Consumer Protection\"},\"timestamp\":197,\"title\":\"Assembly Standing Committee on Privacy and Consumer Protection\",\"videoLength\":1308,\"fileId\":\"5d27e1327cb64797d633226e394ea5f9\"}],\"house\":\"Assembly\",\"id\":\"ca_202320240ab2863\",\"latestVersionDate\":\"2024-09-24\",\"progress\":[{\"label\":\"Introduced\",\"subLabel\":null,\"icon\":\"checked\"},{\"label\":\"In Committee\",\"subLabel\":null,\"icon\":\"checked\"},{\"label\":\"First Chamber\",\"subLabel\":null,\"icon\":\"checked\"},{\"label\":\"In Committee\",\"subLabel\":null,\"icon\":\"checked\"},{\"label\":\"Second Chamber\",\"subLabel\":null,\"icon\":\"checked\"},{\"label\":\"Enacted\",\"subLabel\":null,\"icon\":\"checked\"}],\"sessionYear\":\"2023-2024\",\"status\":[{\"date\":\"2024-09-24\",\"text\":\"Chaptered by Secretary of State - Chapter 515, Statutes of 2024.\"},{\"date\":\"2024-09-24\",\"text\":\"Approved by the Governor.\"},{\"date\":\"2024-09-09\",\"text\":\"Enrolled and presented to the Governor at  3:30 p.m.\"},{\"date\":\"2024-08-28\",\"text\":\"Senate amendments concurred in. To Engrossing and Enrolling. (Ayes 75. Noes  0.).\"},{\"date\":\"2024-08-28\",\"text\":\"In Assembly.  Concurrence in Senate amendments pending.  May be considered on or after August  30 pursuant to Assembly Rule 77.\"},{\"date\":\"2024-08-28\",\"text\":\"Assembly Rule 77 suspended.\"},{\"date\":\"2024-08-27\",\"text\":\"Read third time. Passed. Ordered to the Assembly. (Ayes 35. Noes  1.).\"},{\"date\":\"2024-08-26\",\"text\":\"Read second time. Ordered to third reading.\"},{\"date\":\"2024-08-23\",\"text\":\"Read third time and amended. Ordered to second reading.\"},{\"date\":\"2024-06-27\",\"text\":\"Read second time and amended.  Ordered to third reading.\"},{\"date\":\"2024-06-26\",\"text\":\"From committee: Amend, and do pass as amended. (Ayes 11. Noes  0.) (June  25).\"},{\"date\":\"2024-06-17\",\"text\":\"From committee chair, with author's amendments:  Amend, and re-refer to committee.  Read second time, amended, and re-referred to Com. on  JUD.\"},{\"date\":\"2024-05-29\",\"text\":\"Referred to Com. on  JUD.\"},{\"date\":\"2024-05-16\",\"text\":\"In Senate.  Read first time.  To Com. on RLS. for assignment.\"},{\"date\":\"2024-05-16\",\"text\":\"Read third time. Passed. Ordered to the Senate. (Ayes 65. Noes  0.)\"},{\"date\":\"2024-05-02\",\"text\":\"Read second time. Ordered to third reading.\"},{\"date\":\"2024-05-01\",\"text\":\"From committee:  Do pass. (Ayes 10. Noes  0.) (April  30).\"},{\"date\":\"2024-05-01\",\"text\":\"Coauthors revised.\"},{\"date\":\"2024-04-01\",\"text\":\"Re-referred to Com. on  P. \u0026 C.P.\"},{\"date\":\"2024-03-21\",\"text\":\"Referred to Com. on  P. \u0026 C.P.\"},{\"date\":\"2024-03-21\",\"text\":\"From committee chair, with author's amendments:  Amend, and re-refer to Com. on  P. \u0026 C.P. Read second time and amended.\"},{\"date\":\"2024-02-16\",\"text\":\"From printer.  May be heard in committee  March  17.\"},{\"date\":\"2024-02-15\",\"text\":\"Read first time.  To print.\"}],\"summary\":[{\"label\":\"Chaptered (9/24/2024)\",\"value\":\"CA_20230AB286393CHP\",\"version\":\"CA_20230AB286393CHP\",\"content\":\"$34\"},{\"label\":\"Enrolled (8/31/2024)\",\"value\":\"CA_20230AB286394ENR\",\"version\":\"CA_20230AB286394ENR\",\"content\":\"$35\"},{\"label\":\"Amended Senate (8/23/2024)\",\"value\":\"CA_20230AB286395AMD\",\"version\":\"CA_20230AB286395AMD\",\"content\":\"$36\"},{\"label\":\"Amended Senate (6/27/2024)\",\"value\":\"CA_20230AB286396AMD\",\"version\":\"CA_20230AB286396AMD\",\"content\":\"$37\"},{\"label\":\"Amended Senate (6/17/2024)\",\"value\":\"CA_20230AB286397AMD\",\"version\":\"CA_20230AB286397AMD\",\"content\":\"$38\"},{\"label\":\"Amended Assembly (3/21/2024)\",\"value\":\"CA_20230AB286398AMD\",\"version\":\"CA_20230AB286398AMD\",\"content\":\"$39\"},{\"label\":\"Introduced (2/15/2024)\",\"value\":\"CA_20230AB286399INT\",\"version\":\"CA_20230AB286399INT\",\"content\":\"\u003cp\u003eExisting law regulates automatic purchase renewals and makes it unlawful for a business that makes an automatic renewal offer or continuous service offer, as defined, to a consumer in this state to fail to present the terms in a clear and conspicuous manner before the subscription or purchasing agreement is fulfilled and in either visual or temporal proximity to the request for consent to the offer, as specified.\u003c/p\u003e\u003cp\u003eThis bill would state the intent of the Legislature to enhance consumer protections with regards to automatic subscription renewals and the termination of those automatic subscription renewals.\u003c/p\u003e\"}],\"text\":[{\"label\":\"Chaptered (9/24/2024)\",\"value\":\"CA_20230AB286393CHP\",\"version\":\"CA_20230AB286393CHP\",\"content\":\"$3a\"},{\"label\":\"Enrolled (8/31/2024)\",\"value\":\"CA_20230AB286394ENR\",\"version\":\"CA_20230AB286394ENR\",\"content\":\"$3b\"},{\"label\":\"Amended Senate (8/23/2024)\",\"value\":\"CA_20230AB286395AMD\",\"version\":\"CA_20230AB286395AMD\",\"content\":\"$3c\"},{\"label\":\"Amended Senate (6/27/2024)\",\"value\":\"CA_20230AB286396AMD\",\"version\":\"CA_20230AB286396AMD\",\"content\":\"$3d\"},{\"label\":\"Amended Senate (6/17/2024)\",\"value\":\"CA_20230AB286397AMD\",\"version\":\"CA_20230AB286397AMD\",\"content\":\"$3e\"},{\"label\":\"Amended Assembly (3/21/2024)\",\"value\":\"CA_20230AB286398AMD\",\"version\":\"CA_20230AB286398AMD\",\"content\":\"$3f\"},{\"label\":\"Introduced (2/15/2024)\",\"value\":\"CA_20230AB286399INT\",\"version\":\"CA_20230AB286399INT\",\"content\":\"\u003ccaml:Preamble\u003eThe people of the State of California do enact as follows:\u003c/caml:Preamble\u003e\u003ccaml:BillSection id=\\\"id_92A0D0F5-2A66-412A-8B3C-C4E7DFAED8F5\\\"\u003e\u003ccaml:Num\u003eSECTION 1.\u003c/caml:Num\u003e\u003ccaml:Content\u003e\u003cp\u003eIt is the intent of the Legislature to enhance consumer protections with regards to automatic subscription renewals and the termination of those automatic subscription renewals.\u003c/p\u003e\u003c/caml:Content\u003e\u003c/caml:BillSection\u003e\"}],\"title\":\"AB 2863: Automatic renewal and continuous service offers.\",\"votes\":[{\"date\":\"2024-08-28\",\"location\":\"Assembly Floor\",\"result\":\"Passed\",\"description\":\"AB 2863 Schiavo Concurrence in Senate Amendments\",\"voteDetail\":true,\"abstain\":4,\"ayes\":75,\"naes\":0,\"pro\":[{\"pid\":10,\"href\":\"/legislators/tom-lackey-10\",\"imageSrc\":\