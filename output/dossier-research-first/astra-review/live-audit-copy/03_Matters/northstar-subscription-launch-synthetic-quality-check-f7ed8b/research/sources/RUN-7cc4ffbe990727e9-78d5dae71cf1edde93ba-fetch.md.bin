ers.digitaldemocracy.org/wp-content/uploads/sites/2/2023/12/liz-ortega-1977.jpg\",\"party\":\"Democrat\",\"title\":\"Liz Ortega\"},{\"pid\":165417,\"href\":\"/legislators/steve-bennett-165417\",\"imageSrc\":\"https://wp-calmatters.digitaldemocracy.org/wp-content/uploads/sites/2/2023/12/steve-bennett-1950.jpg\",\"party\":\"Democrat\",\"title\":\"Steve Bennett\"},{\"pid\":165418,\"href\":\"/legislators/eloise-gomez-reyes-165418\",\"imageSrc\":\"https://wp-calmatters.digitaldemocracy.org/wp-content/uploads/sites/2/2023/12/eloise-gomez-reyes-1956.jpg\",\"party\":\"Democrat\",\"title\":\"Eloise Gómez Reyes\"},{\"pid\":165420,\"href\":\"/legislators/josh-hoover-165420\",\"imageSrc\":\"https://wp-calmatters.digitaldemocracy.org/wp-content/uploads/sites/2/2023/12/josh-hoover-1988.jpg\",\"party\":\"Republican\",\"title\":\"Josh Hoover\"},{\"pid\":165421,\"href\":\"/legislators/tasha-boerner-horvath-165421\",\"imageSrc\":\"https://wp-calmatters.digitaldemocracy.org/wp-content/uploads/sites/2/2023/12/Boerner-Horvath-116-Aug-2022.jpeg\",\"party\":\"Democrat\",\"title\":\"Tasha Boerner\"},{\"pid\":165422,\"href\":\"/legislators/mia-bonta-165422\",\"imageSrc\":\"https://wp-calmatters.digitaldemocracy.org/wp-content/uploads/sites/2/2023/12/mia-bonta-1972.jpg\",\"party\":\"Democrat\",\"title\":\"Mia Bonta\"},{\"pid\":165423,\"href\":\"/legislators/diane-papan-165423\",\"imageSrc\":\"https://wp-calmatters.digitaldemocracy.org/wp-content/uploads/sites/2/2023/12/diane-papan-1963.jpg\",\"party\":\"Democrat\",\"title\":\"Diane Papan\"},{\"pid\":165424,\"href\":\"/legislators/jasmeet-bains-165424\",\"imageSrc\":\"https://wp-calmatters.digitaldemocracy.org/wp-content/uploads/sites/2/2023/12/jasmeet-bains-1985.jpg\",\"party\":\"Democrat\",\"title\":\"Jasmeet Bains\"},{\"pid\":165425,\"href\":\"/legislators/damon-connolly-165425\",\"imageSrc\":\"https://wp-calmatters.digitaldemocracy.org/wp-content/uploads/sites/2/2023/12/damon-connolly-1963.jpg\",\"party\":\"Democrat\",\"title\":\"Damon Co