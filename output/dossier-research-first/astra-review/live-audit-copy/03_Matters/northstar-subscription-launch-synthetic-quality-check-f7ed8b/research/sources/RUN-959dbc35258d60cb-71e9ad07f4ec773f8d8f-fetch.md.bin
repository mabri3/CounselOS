    }
  });
</script>
<!-- SnippetEnd: szlLJqVBG --><!-- Snippet: RrnNuoD6v --><script>
(function() {
  var UTM_PARAMS = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
  var COOKIE_EXPIRY_DAYS = 30;

  function getQueryParam(param) {
    return new URLSearchParams(window.location.search).get(param);
  }

  function setCookie(name, value, days) {
    var date = new Date();
    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
    document.cookie = name + "=" + encodeURIComponent(value) + ";expires=" + date.toUTCString() + ";path=/";
  }

  function getCookie(name) {
    var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return match ? decodeURIComponent(match[2]) : null;
  }

  UTM_PARAMS.forEach(function(param) {
    var urlValue = getQueryParam(param);
    if (urlValue) {
      setCookie(param, urlValue, COOKIE_EXPIRY_DAYS);
      if (!getCookie("first_" + param)) {
        setCookie("first_" + param, urlValue, COOKIE_EXPIRY_DAYS);
      }
    }
  });

  // Full URL of the page the visitor is on (host + path, no query/protocol)
  function getPageUrl() {
    return window.location.host + window.location.pathname;
  }

  function getUtmValues() {
    var vals = {};
    UTM_PARAMS.forEach(function(k) {
      vals[k] = getQueryParam(k) || getCookie(k) || "";
    });
    vals.utm_class_url = getPageUrl();
    return vals;
  }

  function findEmbedIframes(doc) {
    var results = [];
    try {
      var iframes = doc.querySelectorAll("iframe");
      for (var i = 0; i < iframes.length; i++) {
        var src = iframes[i].getAttribute("src") || "";
        if (src.indexOf("/embed/") > -1) {
          results.push(iframes[i]);
        }
        try {
          if (iframes[i].contentDocument) {
            var nested = findEmbedIframes(iframes[i].contentDocument);
            results = results.concat(nested);
          }
        } catch(e) {}
      }
    } catch(e) {}
    return results;
  }

  function injectUtmsIntoIframes() {
    var vals = getUtmValues();
    var q = new URLSearchParams();
    UTM_PARAMS.forEach(function(k) { if (vals[k]) q.set(k, vals[k]); });
    q.set("utm_class_url", vals.utm_class_url);
    var qs = q.toString();

    var iframes = findEmbedIframes(document);
    iframes.forEach(function(iframe) {
      if (iframe.dataset.gcUtmDone) return;
      iframe.dataset.gcUtmDone = "1";
      var src = iframe.getAttribute("src") || "";
      iframe.src = src + (src.indexOf("?") > -1 ? "&" : "?") + qs;
    });
  }

  function sendUtmsViaPostMessage() {
    var msg = { type: "gc-utm-params" };
    var vals = getUtmValues();
    UTM_PARAMS.forEach(function(k) { msg[k] = vals[k]; });
    msg.utm_class_url = vals.utm_class_url;

    var iframes = findEmbedIframes(document);
    iframes.forEach(function(iframe) {
      try { iframe.contentWindow.postMessage(msg, "*"); } catch(e) {}
    });
  }

  var observer = new MutationObserver(function() {
    injectUtmsIntoIframes();
  });
  observer.observe(document.documentElement, { childList: true, subtree: true });

  injectUtmsIntoIframes();

  window.addEventListener("message", function(e) {
    if (e.data && e.data.type === "gc-form-request-utm") {
      sendUtmsViaPostMessage();
      injectUtmsIntoIframes();
    }
    if (e.data && e.data.type === "gc-form-resize") {
      var iframes = findEmbedIframes(document);
      iframes.forEach(function(iframe) {
        try {
          if (e.source === iframe.contentWindow) {
            iframe.style.height = e.data.height + "px";
          }
        } catch(e) {}
      });
    }
  });

  // --- HUBSPOT FORM HOOK ---
  window.addEventListener("load", function() {
    if (window.hbspt) {
      var originalCreate = window.hbspt.forms.create;
      window.hbspt.forms.create = function(config) {
        var originalOnFormReady = config.onFormReady;
        config.onFormReady = function($form) {
          UTM_PARAMS.forEach(function(param) {
            var value = getQueryParam(param) || getCookie(param);
            if (value) {
              var field = $form.find('input[name="' + param + '"]');
              if (field.length) field.val(value);
            }
            var firstValue = getCookie("first_" + param);
            if (firstValue) {
              var firstField = $form.find('input[name="first_' + param + '"]');
              if (firstField.length) firstField.val(firstValue);
            }
          });
          if (originalOnFormReady) originalOnFormReady($form);
        };
        return originalCreate(config);
      };
    }
  });

  window.addEventListener("load", function() {
    injectUtmsIntoIframes();
    setTimeout(injectUtmsIntoIframes, 500);
    setTimeout(injectUtmsIntoIframes, 1000);
    setTimeout(injectUtmsIntoIframes, 2000);
    setTimeout(injectUtmsIntoIframes, 3000);
    setTimeout(sendUtmsViaPostMessage, 500);
    setTimeout(sendUtmsViaPostMessage, 2000);
  });
})();
</script>
<!-- SnippetEnd: RrnNuoD6v --><!-- Snippet: ZH5xyDlHT --><script>
(function () {
  var selector =
    '[data-manage-privacy-choices], .manage-privacy-choices';

  var wiredAttribute = 'data-privacy-button-wired';

  function isDataGrailReady() {
    return Boolean(
      window.DG_BANNER_API &&
      typeof window.DG_BANNER_API.showConsentBanner === "function"
    );
  }

  function updateButtons() {
    var ready = isDataGrailReady();

    document.querySelectorAll(selector).forEach(function (button) {
      if (button.getAttribute(wiredAttribute) !== "true") {
        button.setAttribute(wiredAttribute, "true");

        button.addEventListener("click", function (event) {
          event.preventDefault();

          if (isDataGrailReady()) {
            window.DG_BANNER_API.showConsentBanner();
          }
        });
      }

      /*
       * Native buttons can be disabled while DataGrail loads.
       * For Framer links or other elements, aria-disabled still communicates
       * the state to assistive technology.
       */
      if ("disabled" in button) {
        button.disabled = !ready;
      }

      button.setAttribute("aria-disabled", String(!ready));
    });
  }

  /*
   * Framer can render or replace footer elements after this script runs,
   * so watch for newly rendered buttons.
   */
  var observer = new MutationObserver(updateButtons);

  observer.observe(document.documentElement, {
    childList: true,
    subtree: true
  });

  updateButtons();

  /*
   * DataGrail loads asynchronously through GTM. Poll briefly for the API,
   * then stop once it is ready or after 10 seconds.
   */
  var checks = 0;
  var interval = window.setInterval(function () {
    updateButtons();
    checks += 1;

    if (isDataGrailReady() || checks >= 40) {
      window.clearInterval(interval);
    }
  }, 250);
})();
</script><!-- SnippetEnd: ZH5xyDlHT --><!-- End of bodyEnd -->
