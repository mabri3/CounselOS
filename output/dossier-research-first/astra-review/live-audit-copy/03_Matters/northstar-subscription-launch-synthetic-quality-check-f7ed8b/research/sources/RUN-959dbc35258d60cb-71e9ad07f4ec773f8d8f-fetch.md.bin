name\":\"dBV99BB3c\",\"type\":\"Identifier\"},{\"collection\":\"QbI5v3Z87\",\"name\":\"sZz8t2gdl\",\"type\":\"Identifier\"},{\"collection\":\"QbI5v3Z87\",\"name\":\"XUxVkUyi0\",\"type\":\"Identifier\"},{\"collection\":\"QbI5v3Z87\",\"name\":\"VisuNELxZ\",\"type\":\"Identifier\"},{\"collection\":\"QbI5v3Z87\",\"name\":\"NMgF5QqfG\",\"type\":\"Identifier\"},{\"collection\":\"QbI5v3Z87\",\"name\":\"fb7GHQJdF\",\"type\":\"Identifier\"},{\"collection\":\"QbI5v3Z87\",\"name\":\"IOV3gEV6J\",\"type\":\"Identifier\"},{\"alias\":\"qT9TDtsiU\",\"arguments\":[{\"from\":\"e35d7385-2c88-411f-a16b-1b503cb903f7\",\"orderBy\":[{\"arguments\":[{\"collection\":\"QbI5v3Z87\",\"name\":\"qT9TDtsiU\",\"type\":\"Identifier\"},{\"collection\":\"qT9TDtsiU\",\"name\":\"id\",\"type\":\"Identifier\"}],\"functionName\":\"INDEX_OF\",\"type\":\"FunctionCall\"}],\"select\":[{\"collection\":\"qT9TDtsiU\",\"name\":\"id\",\"type\":\"Identifier\"}],\"type\":\"Select\",\"where\":{\"left\":{\"collection\":\"qT9TDtsiU\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"in\",\"right\":{\"collection\":\"QbI5v3Z87\",\"name\":\"qT9TDtsiU\",\"type\":\"Identifier\"},\"type\":\"BinaryOperation\"}}],\"functionName\":\"FLAT_ARRAY\",\"type\":\"FunctionCall\"},{\"collection\":\"QbI5v3Z87\",\"name\":\"M4wc_Szy4\",\"type\":\"Identifier\"},{\"collection\":\"QbI5v3Z87\",\"name\":\"iAezlzPMY\",\"type\":\"Identifier\"},{\"collection\":\"QbI5v3Z87\",\"name\":\"yPHYUweAz\",\"type\":\"Identifier\"},{\"collection\":\"QbI5v3Z87\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"type\":\"BinaryOperation\",\"operator\":\"==\",\"left\":{\"type\":\"TypeCast\",\"value\":{\"type\":\"Identifier\",\"name\":\"NSfjQQbE5\",\"collection\":\"QbI5v3Z87\"},\"dataType\":\"STRING\"},\"right\":{\"type\":\"LiteralValue\",\"value\":\"termination\"}}}default",[4],{"lBzDGwfPe":5,"NSfjQQbE5":8,"x6dC1aE5q":10,"hIyNiIb8o":12,"tPfA9udlH":14,"Eh_QhdpZo":19,"XO3zcTbGi":22,"jOSklSoSA":25,"SZATyHpf8":40,"dBV99BB3c":42,"sZz8t2gdl":44,"XUxVkUyi0":47,"VisuNELxZ":49,"NMgF5QqfG":51,"fb7GHQJdF":54,"IOV3gEV6J":56,"qT9TDtsiU":59,"M4wc_Szy4":73,"iAezlzPMY":75,"yPHYUweAz":77,"id":79},{"type":6,"value":7},"string","Termination Clause",{"type":6,"value":9},"termination",{"type":6,"value":11},"A contractual provision that sets out how, when, and by whom a contract can be ended before its natural expiration.",{"type":6,"value":13},"August 2026",{"type":15,"value":16},"richtext",{"collectionId":17,"pointer":18},"e35d7385-2c88-411f-a16b-1b503cb903f7default","[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"A termination clause is a contractual provision that defines the circumstances under which a party may end the agreement before its term expires, and the procedures for doing so. It commonly covers termination for cause, such as an uncured material breach, termination for convenience on notice, and termination on events like insolvency or change of control. The clause sets notice periods, cure periods, and the obligations that apply on the way out, including transition assistance and payment of accrued amounts. It works alongside the survival clause, which governs what continues afterward.\"]]]",{"type":15,"value":20},{"collectionId":17,"pointer":21},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"A termination clause defines the exits from a contract: who can leave, on what grounds, with how much notice, and what each side owes on the way out. For in-house counsel, it is the provision that determines whether you are locked into a failing vendor relationship or can walk with 30 days’ notice, and whether a counterparty can drop you mid-project. The clause sets the triggers, the process, and the wind-down obligations.\"]],[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Defines termination for cause, usually tied to an uncured material breach after notice\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Provides for termination for convenience, allowing exit on notice without a breach\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Lists trigger events such as insolvency, bankruptcy, or change of control\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Sets the notice and cure periods that govern how termination unfolds\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Specifies wind-down duties: transition assistance, data return, and payment of accrued amounts\"]]]],[4,\"p\",{\"dir\":\"auto\"},[5,\"Transition-assistance and data-return obligations have become more detailed in SaaS termination clauses as switching costs and data-portability expectations have risen.\"]]]",{"type":15,"value":23},{"collectionId":17,"pointer":24},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"A termination clause appears in \"],[4,\"strong\",null,[5,\"SaaS and subscription agreements, vendor MSAs, employment contracts, leases, services agreements, and \"]],[2,{\"href\":\"https://gc.ai/understanding-investment-management-agreements\",\"openInNewTab\":false,\"smoothScroll\":false,\"relValues\":[],\"motionChild\":true,\"nodeId\":\"jb89IGl9h\",\"scopeId\":\"contentManagement\"},[4,\"a\",null,[4,\"strong\",null,[5,\"investment management agreements\"]]]],[4,\"strong\",null,[5,\".\"]],[5,\" The drafting varies most in SaaS and long-term services, where the customer wants a convenience exit and transition help, and the vendor wants to limit termination to cause. See also: survival, limitation of liability, and force majeure.\"]]]",{"type":26,"value":27},"array",[28,30,32,34,36,38],{"type":6,"value":29},"SyeuV2zbm",{"type":6,"value":31},"qOJji6_fF",{"type":6,"value":33},"dRn05lf3b",{"type":6,"value":35},"PY5bmJkx_",{"type":6,"value":37},"rGreL8dOR",{"type":6,"value":39},"lw2svXZM1",{"type":6,"value":41},"If you are the customer:",{"type":6,"value":43},"You want flexible exits",{"type":15,"value":45},{"collectionId":17,"pointer":46},"[1,[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Add termination for convenience on reasonable notice, often 30 to 90 days.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Keep the cure period for your own breaches generous, often 30 days.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Require transition assistance and data return in a usable format on the way out.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Add a termination right if the vendor misses service levels for consecutive periods.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Provide for a pro-rata refund of prepaid fees on termination for the vendor's breach.\"]]]]]",{"type":6,"value":48},"If you are the vendor:",{"type":6,"value":50},"You want stability and predictable revenue",{"type":15,"value":52},{"collectionId":17,"pointer":53},"[1,[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Limit termination to cause, with a defined and narrow set of triggers.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Keep notice and cure periods short for the customer's breaches, especially non-payment.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Resist termination for convenience, or condition it on an early-termination fee.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Cap transition-assistance obligations in time and scope, and charge for them.\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Confirm fees through the end of the current term are payable on early termination.\"]]]]]",{"type":6,"value":55},"A termination clause is where the leverage in a contract actually lives. Read whether you can leave, what it costs to leave, and what the other side owes you when they do, before the relationship gives you a reason to.",{"type":15,"value":57},{"collectionId":17,"pointer":58},"[1,[4,\"ul\",{\"dir\":\"auto\"},[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"A termination-for-convenience right that runs only to the counterparty, locking you in while they can walk\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"No transition-assistance or data-return obligation, leaving you stranded when a vendor relationship ends\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Cure periods so short that an inadvertent breach becomes an immediate termination right for the other side\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Early-termination fees that effectively make a convenience right unusable\"]]],[4,\"li\",{\"data-preset-tag\":\"p\"},[4,\"p\",null,[5,\"Fees that continue through a multi-year term with no exit, regardless of performance\"]]]]]",{"type":26,"value":60},[61,63,65,67,69,71],{"type":6,"value":62},"exKf4L8Tp",{"type":6,"value":64},"Ogfv9MIFS",{"type":6,"value":66},"bWuvxWzft",{"type":6,"value":68},"O4XiZVzkY",{"type":6,"value":70},"LsJf7RfED",{"type":6,"value":72},"HnERSDBsx",{"type":6,"value":74},"Find Every Gap in Your Termination Clause",{"type":6,"value":76},"Termination Clause: For Cause, For Convenience, and Examples",{"type":6,"value":78},"How a termination clause defines exits for cause and for convenience, the notice and wind-down terms that matter, and real examples. Reviewed by a JD.",{"type":6,"value":80},"qPeV4Sgwh","{\"from\":\"44a6a8d1-7c91-4694-affb-6d616622e080\",\"limit\":{\"type\":\"LiteralValue\",\"value\":10},\"orderBy\":[{\"arguments\":[{\"type\":\"LiteralValue\",\"value\":[\"SyeuV2zbm\",\"qOJji6_fF\",\"dRn05lf3b\",\"PY5bmJkx_\",\"rGreL8dOR\",\"lw2svXZM1\"]},{\"collection\":\"oPgzHsSFN\",\"name\":\"id\",\"type\":\"Identifier\"}],\"direction\":\"asc\",\"functionName\":\"INDEX_OF\",\"type\":\"FunctionCall\"}],\"select\":[{\"collection\":\"oPgzHsSFN\",\"name\":\"rnSlEHOSO\",\"type\":\"Identifier\"},{\"collection\":\"oPgzHsSFN\",\"name\":\"Hs38r28Td\",\"type\":\"Identifier\"},{\"collection\":\"oPgzHsSFN\",\"name\":\"TYNYw2AIW\",\"type\":\"Identifier\"},{\"collection\":\"oPgzHsSFN\",\"name\":\"WkzJrwqzk\",\"type\":\"Identifier\"},{\"collection\":\"oPgzHsSFN\",\"name\":\"I2XkUb4GG\",\"type\":\"Identifier\"},{\"collection\":\"oPgzHsSFN\",\"name\":\"pt1xE_277\",\"type\":\"Identifier\"},{\"collection\":\"oPgzHsSFN\",\"name\":\"LKYqdLO6I\",\"type\":\"Identifier\"},{\"collection\":\"oPgzHsSFN\",\"name\":\"Di_1lo7LF\",\"type\":\"Identifier\"},{\"collection\":\"oPgzHsSFN\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"oPgzHsSFN\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"in\",\"right\":{\"type\":\"LiteralValue\",\"value\":[\"SyeuV2zbm\",\"qOJji6_fF\",\"dRn05lf3b\",\"PY5bmJkx_\",\"rGreL8dOR\",\"lw2svXZM1\"]},\"type\":\"BinaryOperation\"}}default",[83,105,123,140,157,175],{"rnSlEHOSO":84,"Hs38r28Td":86,"TYNYw2AIW":88,"WkzJrwqzk":90,"I2XkUb4GG":93,"pt1xE_277":95,"LKYqdLO6I":99,"Di_1lo7LF":102,"id":104},{"type":6,"value":85},"Streamline Health Solutions, Inc. / Consultant",{"type":6,"value":87},"Master Services and Non-Disclosure Agreement",{"type":6,"value":89},"Auto-renew",{"type":91,"value":92},"enum","Pj41HKw9b",{"type":6,"value":94},"2025",{"type":15,"value":96},{"collectionId":97,"pointer":98},"44a6a8d1-7c91-4694-affb-6d616622e080default","[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"\\\"Following the Initial Term, the term of this Agreement will \"],[4,\"strong\",null,[5,\"automatically renew for successive periods of twelve (12) months\"]],[5,\" (each, a 'Renewal Term'), unless (a) Company provides written notice to Consultant that it does not desire to extend the term of this Agreement at least six (6) months prior to the expiration of Initial Term, or (b) following the Initial Term, either party hereto provides written notice to the other party that it does not desire to extend the term...\\\"\"]]]",{"type":100,"value":101},"link","https://www.sec.gov/Archives/edgar/data/1008586/000143774925018850/ex_824906.htm",{"type":6,"value":103},"termination-1",{"type":6,"value":29},{"rnSlEHOSO":106,"Hs38r28Td":108,"TYNYw2AIW":110,"WkzJrwqzk":112,"I2XkUb4GG":113,"pt1xE_277":115,"LKYqdLO6I":118,"Di_1lo7LF":120,"id":122},{"type":6,"value":107},"Quantum-Si Incorporated / Jonathan Rothberg",{"type":6,"value":109},"Advisory Agreement",{"type":6,"value":111},"For convenience",{"type":91,"value":92},{"type":6,"value":114},"2023",{"type":15,"value":116},{"collectionId":97,"pointer":117},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"\\\"Either party may \"],[4,\"strong\",null,[5,\"terminate this Agreement for any reason upon giving thirty (30) days' advance notice\"]],[5,\" of such termination. In the event of such termination of this Agreement, Dr. Rothberg's entitlements under the Option ... will survive the termination of this Agreement.\\\"\"]]]",{"type":100,"value":119},"https://www.sec.gov/Archives/edgar/data/1816431/000114036123012126/brhc10049653_ex10-6.htm",{"type":6,"value":121},"termination-2",{"type":6,"value":31},{"rnSlEHOSO":124,"Hs38r28Td":126,"TYNYw2AIW":128,"WkzJrwqzk":130,"I2XkUb4GG":131,"pt1xE_277":132,"LKYqdLO6I":135,"Di_1lo7LF":137,"id":139},{"type":6,"value":125},"Jounce Therapeutics, Inc. / Hugh Cole",{"type":6,"value":127},"Consulting Agreement",{"type":6,"value":129},"For convenience (asymmetric notice)",{"type":91,"value":92},{"type":6,"value":114},{"type":15,"value":133},{"collectionId":97,"pointer":134},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"\\\"Jounce may terminate this Agreement for any reason upon ninety (90) days' prior written notice to the Consultant. The Consultant may terminate this Agreement for any reason upon fourteen (14) days' prior written notice to Jounce. \"],[4,\"strong\",null,[5,\"Either party may terminate this Agreement immediately upon breach by the other party.\"]],[5,\"\\\"\"]]]",{"type":100,"value":136},"https://www.sec.gov/Archives/edgar/data/1640455/000164045523000018/exhibit105coleconsultingag.htm",{"type":6,"value":138},"termination-3",{"type":6,"value":33},{"rnSlEHOSO":141,"Hs38r28Td":143,"TYNYw2AIW":145,"WkzJrwqzk":147,"I2XkUb4GG":148,"pt1xE_277":149,"LKYqdLO6I":152,"Di_1lo7LF":154,"id":156},{"type":6,"value":142},"Repay Holdings Corporation / Consultant",{"type":6,"value":144},"Transitional Consulting Agreement",{"type":6,"value":146},"Convenience + cause",{"type":91,"value":92},{"type":6,"value":114},{"type":15,"value":150},{"collectionId":97,"pointer":151},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"\\\"(b) Either the Company or Consultant may \"],[4,\"strong\",null,[5,\"terminate this Agreement for convenience by providing at least thirty (30) days prior written notice\"]],[5,\" to the other party. (c) Either the Company or Consultant may terminate this Agreement for any material breach of this Agreement by the other party upon ten (10) days prior written notice to the other party containing the details of the breach, provided the breach remains uncured at the end of the notice period.\\\"\"]]]",{"type":100,"value":153},"https://www.sec.gov/Archives/edgar/data/1720592/000095017023005561/rpay-ex10_26.htm",{"type":6,"value":155},"termination-4",{"type":6,"value":35},{"rnSlEHOSO":158,"Hs38r28Td":160,"TYNYw2AIW":162,"WkzJrwqzk":164,"I2XkUb4GG":165,"pt1xE_277":167,"LKYqdLO6I":170,"Di_1lo7LF":172,"id":174},{"type":6,"value":159},"PaxMedica, Inc. / PoloMar Health",{"type":6,"value":161},"Data Sharing Agreement",{"type":6,"value":163},"For cause + 30-day cure",{"type":91,"value":92},{"type":6,"value":166},"2024",{"type":15,"value":168},{"collectionId":97,"pointer":169},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"\\\"Either party may \"],[4,\"strong\",null,[5,\"terminate this Agreement with written notice to the other party in the event of a material breach that remains uncured for a period of thirty (30) days.\"]],[5,\"\\\"\"]]]",{"type":100,"value":171},"https://www.sec.gov/Archives/edgar/data/1811623/000155837024002911/pxmd-20231231xex10d25.htm",{"type":6,"value":173},"termination-5",{"type":6,"value":37},{"rnSlEHOSO":176,"Hs38r28Td":178,"TYNYw2AIW":180,"WkzJrwqzk":181,"I2XkUb4GG":182,"pt1xE_277":183,"LKYqdLO6I":186,"Di_1lo7LF":188,"id":190},{"type":6,"value":177},"Near North America Inc. / MobileFuse, LLC",{"type":6,"value":179},"Platform Usage Agreement",{"type":6,"value":89},{"type":91,"value":92},{"type":6,"value":114},{"type":15,"value":184},{"collectionId":97,"pointer":185},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"\\\"The T&C's will \"],[4,\"strong\",null,[5,\"automatically renew for successive periods of 1 (one) year each\"]],[5,\" ('Renewal Term') unless either party provides the other party with written notice of at least 180 (one-hundred and eighty) days' prior to the expiry of the Initial Term or subsequent Renewal Term, that this Agreement shall not be renewed. During the Term, either party may terminate this Agreement with six (6) months prior written notice to the other party.\\\"\"]]]",{"type":100,"value":187},"https://www.sec.gov/Archives/edgar/data/1826671/000121390023023757/ea175363ex10-12_nearintell.htm",{"type":6,"value":189},"termination-6",{"type":6,"value":39},"{\"from\":\"e35d7385-2c88-411f-a16b-1b503cb903f7\",\"limit\":{\"type\":\"LiteralValue\",\"value\":10},\"orderBy\":[{\"arguments\":[{\"type\":\"LiteralValue\",\"value\":[\"exKf4L8Tp\",\"Ogfv9MIFS\",\"bWuvxWzft\",\"O4XiZVzkY\",\"LsJf7RfED\",\"HnERSDBsx\"]},{\"collection\":\"J8J3uvANA\",\"name\":\"id\",\"type\":\"Identifier\"}],\"direction\":\"asc\",\"functionName\":\"INDEX_OF\",\"type\":\"FunctionCall\"}],\"select\":[{\"collection\":\"J8J3uvANA\",\"name\":\"zZZK6J7IA\",\"type\":\"Identifier\"},{\"collection\":\"J8J3uvANA\",\"name\":\"x6dC1aE5q\",\"type\":\"Identifier\"},{\"collection\":\"J8J3uvANA\",\"name\":\"NSfjQQbE5\",\"type\":\"Identifier\"},{\"collection\":\"J8J3uvANA\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"J8J3uvANA\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"in\",\"right\":{\"type\":\"LiteralValue\",\"value\":[\"exKf4L8Tp\",\"Ogfv9MIFS\",\"bWuvxWzft\",\"O4XiZVzkY\",\"LsJf7RfED\",\"HnERSDBsx\"]},\"type\":\"BinaryOperation\"}}default",[193,201,209,217,225,233],{"zZZK6J7IA":194,"x6dC1aE5q":196,"NSfjQQbE5":198,"id":200},{"type":6,"value":195},"Survival",{"type":6,"value":197},"A contractual provision that keeps specified obligations enforceable after the agreement expires or is terminated.",{"type":6,"value":199},"survival",{"type":6,"value":62},{"zZZK6J7IA":202,"x6dC1aE5q":204,"NSfjQQbE5":206,"id":208},{"type":6,"value":203},"Limitation of Liability",{"type":6,"value":205},"A contractual provision that caps the amount and types of damages one party can recover from the other.",{"type":6,"value":207},"limitation-of-liability",{"type":6,"value":64},{"zZZK6J7IA":210,"x6dC1aE5q":212,"NSfjQQbE5":214,"id":216},{"type":6,"value":211},"Force Majeure",{"type":6,"value":213},"A contractual provision that excuses performance when an extraordinary event prevents one or both parties from fulfilling their obligations.",{"type":6,"value":215},"force-majeure",{"type":6,"value":66},{"zZZK6J7IA":218,"x6dC1aE5q":220,"NSfjQQbE5":222,"id":224},{"type":6,"value":219},"Change of Control",{"type":6,"value":221},"A contractual provision that triggers rights or obligations when one party is acquired or undergoes a change in ownership.",{"type":6,"value":223},"change-of-control",{"type":6,"value":68},{"zZZK6J7IA":226,"x6dC1aE5q":228,"NSfjQQbE5":230,"id":232},{"type":6,"value":227},"Indemnification",{"type":6,"value":229},"A contractual provision in which one party agrees to cover specified losses or third-party claims that the other party incurs.",{"type":6,"value":231},"indemnification",{"type":6,"value":70},{"zZZK6J7IA":234,"x6dC1aE5q":236,"NSfjQQbE5":238,"id":240},{"type":6,"value":235},"Notices",{"type":6,"value":237},"Specifies how formal notices must be delivered, where they go, and when the contract treats them as received.",{"type":6,"value":239},"notices",{"type":6,"value":72},"{\"from\":{\"constraint\":{\"left\":{\"collection\":\"pc8xK5wjQ\",\"name\":\"evpQ9uZRi\",\"type\":\"Identifier\"},\"operator\":\"==\",\"right\":{\"collection\":\"evpQ9uZRi\",\"name\":\"id\",\"type\":\"Identifier\"},\"type\":\"BinaryOperation\"},\"left\":\"3ae148d7-6efe-4be0-a2be-c7d2ca74acbe\",\"right\":\"e35d7385-2c88-411f-a16b-1b503cb903f7\",\"type\":\"LeftJoin\"},\"orderBy\":[{\"collection\":\"pc8xK5wjQ\",\"name\":\"X5XDyg9au\",\"type\":\"Identifier\"}],\"select\":[{\"collection\":\"pc8xK5wjQ\",\"name\":\"LQJDIaEaK\",\"type\":\"Identifier\"},{\"collection\":\"pc8xK5wjQ\",\"name\":\"mP7BjSfx0\",\"type\":\"Identifier\"},{\"collection\":\"pc8xK5wjQ\",\"name\":\"PHiW549mi\",\"type\":\"Identifier\"},{\"collection\":\"pc8xK5wjQ\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"left\":{\"collection\":\"evpQ9uZRi\",\"name\":\"id\",\"type\":\"Identifier\"},\"operator\":\"==\",\"right\":{\"type\":\"LiteralValue\",\"value\":\"qPeV4Sgwh\"},\"type\":\"BinaryOperation\"},\"operator\":\"and\",\"right\":{\"left\":{\"collection\":\"pc8xK5wjQ\",\"name\":\"X5XDyg9au\",\"type\":\"Identifier\"},\"operator\":\"\u003C\",\"right\":{\"type\":\"LiteralValue\",\"value\":15},\"type\":\"BinaryOperation\"},\"type\":\"BinaryOperation\"}}default",[243,254,264,274,284,294],{"LQJDIaEaK":244,"mP7BjSfx0":246,"PHiW549mi":250,"id":252},{"type":6,"value":245},"What is a termination clause?",{"type":15,"value":247},{"collectionId":248,"pointer":249},"3ae148d7-6efe-4be0-a2be-c7d2ca74acbedefault","[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"A termination clause is a contractual provision that sets out how, when, and by whom a contract can be ended before its natural expiration, including the notice and cure procedures that apply.\"]]]",{"type":6,"value":251},"what-is-a-termination-clause",{"type":6,"value":253},"MC9qVjvAT",{"LQJDIaEaK":255,"mP7BjSfx0":257,"PHiW549mi":260,"id":262},{"type":6,"value":256},"What is the difference between termination for cause and termination for convenience?",{"type":15,"value":258},{"collectionId":248,"pointer":259},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"Termination for cause ends the contract because of a breach or defined trigger, usually after notice and a cure period. Termination for convenience lets a party end the contract without any breach, on notice. Convenience rights are more valuable and more heavily negotiated.\"]]]",{"type":6,"value":261},"what-is-the-difference-between-termination-for-cause-and-termination-for-convenience",{"type":6,"value":263},"ZZrUNSB2P",{"LQJDIaEaK":265,"mP7BjSfx0":267,"PHiW549mi":270,"id":272},{"type":6,"value":266},"How much notice does a termination clause require?",{"type":15,"value":268},{"collectionId":248,"pointer":269},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"It depends on the drafting. Termination for convenience commonly requires 30 to 90 days' written notice, while termination for cause often requires notice plus a cure period, frequently 30 days, before termination takes effect.\"]]]",{"type":6,"value":271},"how-much-notice-does-a-termination-clause-require",{"type":6,"value":273},"E1ock9DIF",{"LQJDIaEaK":275,"mP7BjSfx0":277,"PHiW549mi":280,"id":282},{"type":6,"value":276},"What happens to obligations after a contract is terminated?",{"type":15,"value":278},{"collectionId":248,"pointer":279},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"A survival clause governs which obligations continue, such as confidentiality and indemnification, while the termination clause usually sets wind-down duties like transition assistance, data return, and payment of accrued amounts.\"]]]",{"type":6,"value":281},"what-happens-to-obligations-after-a-contract-is-terminated",{"type":6,"value":283},"E0O7sBFCb",{"LQJDIaEaK":285,"mP7BjSfx0":287,"PHiW549mi":290,"id":292},{"type":6,"value":286},"Can a contract be terminated without a termination clause?",{"type":15,"value":288},{"collectionId":248,"pointer":289},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"Sometimes, under common-law principles such as material breach, but without a clause the grounds and process are uncertain. An express termination clause is the safer way to define the exits.\"]]]",{"type":6,"value":291},"can-a-contract-be-terminated-without-a-termination-clause",{"type":6,"value":293},"UK9N81sbv",{"LQJDIaEaK":295,"mP7BjSfx0":297,"PHiW549mi":300,"id":302},{"type":6,"value":296},"Does termination for convenience require a reason?",{"type":15,"value":298},{"collectionId":248,"pointer":299},"[1,[4,\"p\",{\"dir\":\"auto\"},[5,\"No. A termination-for-convenience provision lets a party end the contract without cause or justification, provided it gives the required notice and meets any associated conditions, such as an early-termination fee.\"]]]",{"type":6,"value":301},"does-termination-for-convenience-require-a-reason",{"type":6,"value":303},"Bk88cvrva",["Map"]]</script><div id="svg-templates" style="position: absolute; overflow: hidden; bottom: 0; left: 0; width: 0; height: 0; z-index: 0; contain: strict" aria-hidden="true">
