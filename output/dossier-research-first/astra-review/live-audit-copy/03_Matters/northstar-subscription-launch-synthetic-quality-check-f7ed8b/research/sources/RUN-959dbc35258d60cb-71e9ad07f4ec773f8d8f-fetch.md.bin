<!-- 3. Translator: DataGrail preferences -> Google Consent Mode signal -->
<script>
  function gtag(){ dataLayer.push(arguments); }

  function dg_to_consent_mode(preferences) {
    try {
      var options = preferences.consentPreferences.cookieOptions || [];
      var lookup = {};
      options.forEach(function (opt) {
        lookup[opt.gtm_key] = opt.isEnabled;
      });

      var analyticsGranted = lookup['dg-category-performance'] ? 'granted' : 'denied';
      var marketingGranted = lookup['dg-category-marketing'] ? 'granted' : 'denied';

      gtag('consent', 'update', {
        'analytics_storage': analyticsGranted,
        'ad_storage': marketingGranted,
        'ad_user_data': marketingGranted,
        'ad_personalization': marketingGranted
      });

      console.log('Dreamdata consent updated:', {
        analytics_storage: analyticsGranted,
        ad_storage: marketingGranted
      });
    } catch (e) {
      console.error('Error mapping DataGrail preferences to Consent Mode', e);
    }
  }

  window.dgEvent = window.dgEvent || [];

  window.dgEvent.push({
    event: "initial_preference_callback",
    params: dg_to_consent_mode
  });

  window.dgEvent.push({
    event: "preference_callback",
    params: dg_to_consent_mode
  });
</script>
<!-- SnippetEnd: RbpwVOJu2 --><!-- Snippet: ZNwmiv3Pr --><script>
(function () {
  var consentBannerCss = `
:host(.dg-consent-banner) .dg-app {
  box-sizing: border-box;
  padding: 1.5rem;
  border: 0;
  border-radius: 24px;
  flex-flow: row wrap;
  align-items: stretch;
  gap: 0.75rem;
  background: #fffaf5;
  color: #111111;
  box-shadow:
    0 18px 48px rgba(5, 21, 27, 0.16),
    0 2px 8px rgba(5, 21, 27, 0.08);
  font-family: var(--font-aeonik), ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  font-size: 0.875rem;
  font-weight: 400;
  line-height: 1.6;
}

:host(.dg-consent-banner) .dg-app > *:not(.dg-button) {
  flex: 0 0 auto;
  width: 100%;
  min-width: 0;
}

:host(.dg-consent-banner) .dg-app > * {
  box-sizing: border-box;
}

:host(.dg-consent-banner) .dg-main-content-explanation,
:host(.dg-consent-banner) .dg-text-title,
:host(.dg-consent-banner) .dg-text-body,
:host(.dg-consent-banner) .dg-link,
:host(.dg-consent-banner) .dg-browser-signal-notice-text,
:host(.dg-consent-banner) .dg-main-content-policy-option,
:host(.dg-consent-banner) .language-dropdown-trigger > span,
:host(.dg-consent-banner) .language-dropdown-menu button > span {
  font-family: inherit;
}

:host(.dg-consent-banner) .dg-text-title,
:host(.dg-consent-banner) .dg-text-body,
:host(.dg-consent-banner) .dg-main-content-policy-option,
:host(.dg-consent-banner) .dg-main-content-policy-option-heading,
:host(.dg-consent-banner) .language-dropdown-trigger > span {
  color: #111111;
}

:host(.dg-consent-banner) .dg-text-body,
:host(.dg-consent-banner) .dg-main-content-policy-option,
:host(.dg-consent-banner) .dg-main-content-policy-option-heading,
:host(.dg-consent-banner) .language-dropdown-trigger > span {
  font-weight: 400;
}

:host(.dg-consent-banner) .dg-app .dg-main-content-policy-option-description,
:host(.dg-consent-banner) .dg-app .dg-main-content-policy-option-description * {
  font-weight: 400;
  font-size: 1rem;
  line-height: 1.6;
}

:host(.dg-consent-banner) .dg-app .dg-main-content-policy-option-description,
:host(.dg-consent-banner) .dg-app .dg-main-content-policy-option-description > div {
  color: #111111;
}

:host(.dg-consent-banner) .dg-text-title {
  font-size: 1.125rem;
  line-height: 1.4;
}

:host(.dg-consent-banner) .dg-text-body,
:host(.dg-consent-banner) .dg-text-body *,
:host(.dg-consent-banner) .language-dropdown-trigger > span {
  font-size: 1rem;
  line-height: 1.6;
}

:host(.dg-consent-banner) .dg-app .dg-main-content-policy-option-heading,
:host(.dg-consent-banner) .dg-app .dg-main-content-policy-option-heading * {
  font-size: 1rem;
  line-height: 1.4;
}

:host(.dg-consent-banner) .dg-header {
  align-items: center;
}

:host(.dg-consent-banner) .dg-header-close {
  padding: 10px;
  margin: -10px -10px -10px 0;
  color: #111111;
}

:host(.dg-consent-banner) [class*="language"] {
  display: none;
}

:host(.dg-consent-banner) .language-dropdown-trigger,
:host(.dg-consent-banner) .dg-main-content-policy-option {
  background-color: transparent;
}

:host(.dg-consent-banner) .dg-main-content-policy-option {
  border-top-color: #ece7de;
}

:host(.dg-consent-banner) .language-dropdown-menu {
  background-color: #fffaf5;
  border: 1px solid #ece7de;
  border-radius: 12px;
  overflow: hidden;
}

:host(.dg-consent-banner) .language-dropdown-menu-option {
  background-color: transparent;
  color: #111111;
}

:host(.dg-consent-banner) .language-dropdown-menu-option:hover {
  background-color: #f0e9e2;
}

:host(.dg-consent-banner) p {
  margin: 0 0 1.25rem;
  font-size: 0.875rem;
  line-height: 1.6;
  color: #111111;
}

:host(.dg-consent-banner) .dg-links {
  display: inline;
}

:host(.dg-consent-banner) a,
:host(.dg-consent-banner) .dg-link {
  color: #0761b6;
  text-decoration: underline;
  text-underline-offset: 2px;
}

:host(.dg-consent-banner) a:hover,
:host(.dg-consent-banner) .dg-link:hover {
  color: #003047;
}

:host(.dg-consent-banner) .dg-button {
  --dg-button-font-size: 0.875rem;
  --dg-button-font-weight: 500;
  --dg-button-radius: 0.375rem;
  flex: 1 1 0;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 0.625rem 1.25rem;
  border: 0;
  border-radius: 0.375rem;
  font-family: inherit;
  font-size: 0.875rem;
  font-weight: 500;
  line-height: 1.4;
  text-align: center;
  cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease;
}

:host(.dg-consent-banner:not(.dg-modal)) .dg-button {
  flex: 0 0 auto;
  width: 100%;
}

:host(.dg-consent-banner) .dg-button:focus-visible,
:host(.dg-consent-banner) a:focus-visible {
  outline: 2px solid #0761b6;
  outline-offset: 2px;
}

:host(.dg-consent-banner) .reject_all {
  order: 1;
  background-color: #f0e9e2;
  color: #111111;
}

:host(.dg-consent-banner) .reject_all:hover {
  background-color: #d1ccc6;
}

:host(.dg-consent-banner) .accept_all {
  order: 3;
  background-color: #50abda;
  color: #05151b;
}

:host(.dg-consent-banner) .accept_all:hover {
  background-color: #62b3dd;
}

:host(.dg-consent-banner) .accept_some,
:host(.dg-consent-banner) .custom {
  order: 2;
  background-color: #f0e9e2;
  color: #111111;
}

:host(.dg-consent-banner) .open_layer {
  order: 4;
  flex: 0 0 100%;
  padding: 0;
  border-radius: 0;
  background-color: transparent;
  color: #111111;
  font-size: 0.8125rem;
  font-weight: 400;
  text-decoration: underline;
  text-underline-offset: 2px;
}

:host(.dg-consent-banner) .open_layer:hover {
  color: #111111;
  background-color: transparent;
}

/*
 * Keep DataGrail's native modal host layout.
 * This controls only the card size and scrolling.
 */
:host(.dg-consent-banner.dg-modal) .dg-app {
  width: min(52rem, calc(100% - 3rem));
  max-height: calc(100vh - 3rem);
  max-height: calc(100dvh - 3rem);
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-gutter: stable;
}

@media (max-width: 48rem) {
  :host(.dg-consent-banner.dg-modal) .dg-app {
    width: calc(100% - 2rem);
    max-height: calc(100vh - 2rem);
    max-height: calc(100dvh - 2rem);
  }
}

@media (max-width: 40rem) {
  :host(.dg-consent-banner:not(.dg-modal)) {
    inset: auto 0.75rem 0.75rem 0.75rem;
    width: auto;
    max-width: none;
  }

  :host(.dg-consent-banner) .dg-app {
    padding: 1.25rem;
    border-radius: 20px;
  }

  :host(.dg-consent-banner) .dg-button {
    flex: 0 0 auto;
    width: 100%;
  }

  :host(.dg-consent-banner) .dg-app > * {
    margin-left: 0;
    margin-right: 0;
  }

  :host(.dg-consent-banner) .dg-app .dg-main-content-policies {
    padding-left: 0;
    padding-right: 0;
  }

  :host(.dg-consent-banner) .dg-text-title {
    font-size: 1rem;
  }

  :host(.dg-consent-banner) .dg-text-body,
  :host(.dg-consent-banner) .dg-text-body *,
  :host(.dg-consent-banner) .language-dropdown-trigger > span {
    font-size: 0.875rem;
  }

  :host(.dg-consent-banner) .dg-app .dg-main-content-policy-option-heading,
  :host(.dg-consent-banner) .dg-app .dg-main-content-policy-option-heading * {
    font-size: 0.875rem;
  }

  :host(.dg-consent-banner) .dg-app .dg-main-content-policy-option-description,
  :host(.dg-consent-banner) .dg-app .dg-main-content-policy-option-description * {
    font-size: 0.875rem;
  }

  :host(.dg-consent-banner.dg-modal) .dg-app {
    width: calc(100% - 1.5rem);
    max-height: calc(100vh - 1.5rem);
    max-height: calc(100dvh - 1.5rem);
  }
}

@media (prefers-reduced-motion: reduce) {
  :host(.dg-consent-banner),
  :host(.dg-consent-banner) .dg-button {
    transition: none;
  }
}

/*
 * Initial banner position only.
 * The modal position is intentionally left to DataGrail.
 */
:host(.dg-consent-banner:not(.dg-modal)) {
  top: auto !important;
  right: auto !important;
  bottom: 1.5rem !important;
  left: 1.5rem !important;
  margin: 0 !important;
}

@media (max-width: 40rem) {
  :host(.dg-consent-banner:not(.dg-modal)) {
    top: auto !important;
    right: 0.75rem !important;
    bottom: 0.75rem !important;
    left: 0.75rem !important;
  }
}
