    <!-- Snippet: lx_Lgi29e --><script src="https://cdn.thred.dev/thred-track.js?browserKey=d19de329-8998-4d43-b676-63f8463138f0"></script><!-- SnippetEnd: lx_Lgi29e --><!-- Snippet: Km2nq3edZ --><script>
(function () {
  // Origins of the form-embed iframe we trust
  var TRUSTED_ORIGINS = [
    'https://form-sync.replit.app',
    // add other origins here if you preview from a different replit URL
  ];

  window.addEventListener('message', function (event) {
    // Only accept messages from our embedded form
    if (TRUSTED_ORIGINS.indexOf(event.origin) === -1) return;

    var data = event.data;
    if (!data || data.type !== 'gc-form-success') return;

    var fd = data.formData || {};

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'form_submit',
      form_type: data.formType,         // 'demo' or 'class'
      class_id: data.classId,           // 'demo', '101', '105', etc.
      email: fd.email,
      first_name: fd.firstname,
      last_name: fd.lastname,
      company: fd.company,
      // class-form only:
      selected_date_label: fd.selected_date_label
    });
  });
})();
</script><!-- SnippetEnd: Km2nq3edZ --><!-- Snippet: xtdB3cnVk --><script type="application/ld+json">

{"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a termination clause?","acceptedAnswer":{"@type":"Answer","text":"A termination clause is a contractual provision that sets out how, when, and by whom a contract can be ended before its natural expiration, including the notice and cure procedures that apply."}},{"@type":"Question","name":"What is the difference between termination for cause and termination for convenience?","acceptedAnswer":{"@type":"Answer","text":"Termination for cause ends the contract because of a breach or defined trigger, usually after notice and a cure period. Termination for convenience lets a party end the contract without any breach, on notice. Convenience rights are more valuable and more heavily negotiated."}},{"@type":"Question","name":"How much notice does a termination clause require?","acceptedAnswer":{"@type":"Answer","text":"It depends on the drafting. Termination for convenience commonly requires 30 to 90 days' written notice, while termination for cause often requires notice plus a cure period, frequently 30 days, before termination takes effect."}},{"@type":"Question","name":"What happens to obligations after a contract is terminated?","acceptedAnswer":{"@type":"Answer","text":"A survival clause governs which obligations continue, such as confidentiality and indemnification, while the termination clause usually sets wind-down duties like transition assistance, data return, and payment of accrued amounts."}},{"@type":"Question","name":"Can a contract be terminated without a termination clause?","acceptedAnswer":{"@type":"Answer","text":"Sometimes, under common-law principles such as material breach, but without a clause the grounds and process are uncertain. An express termination clause is the safer way to define the exits."}},{"@type":"Question","name":"Does termination for convenience require a reason?","acceptedAnswer":{"@type":"Answer","text":"No. A termination-for-convenience provision lets a party end the contract without cause or justification, provided it gives the required notice and meets any associated conditions, such as an early-termination fee."}}]},{"@type":"Article","headline":"Termination Clause","about":{"@type":"DefinedTerm","name":"termination clause"},"author":{"@type":"Organization","name":"GC AI","url":"https://gc.ai"},"reviewedBy":{"@type":"Person","name":"GC AI Solutions Attorneys","jobTitle":"Solutions Attorney","hasCredential":{"@type":"EducationalOccupationalCredential","credentialCategory":"degree","name":"Juris Doctor (JD)"}},"publisher":{"@type":"Organization","name":"GC AI","url":"https://gc.ai"},"datePublished":"2026-06-16","dateModified":"2026-09-03","url":"https://gc.ai/clauses/termination"},{"@type":"DefinedTerm","name":"termination clause","description":"A termination clause is a contractual provision that defines the circumstances under which a party may end the agreement before its term expires, and the procedures for doing so. It commonly covers termination for cause, termination for convenience on notice, and termination on events like insolvency or change of control, along with notice periods, cure periods, and wind-down obligations.","inDefinedTermSet":"https://gc.ai/clauses/"},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Clauses","item":"https://gc.ai/clauses/"},{"@type":"ListItem","position":2,"name":"Termination Clause","item":"https://gc.ai/clauses/termination"}]}]}

</script><!-- SnippetEnd: xtdB3cnVk --><!-- Snippet: szlLJqVBG --><script>
  document.addEventListener("framer:pageview", (event) => {
