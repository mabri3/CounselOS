{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-firecrawl-repair-build/types/**/*.ts",
    ".next-firecrawl-repair-build/dev/types/**/*.ts",
    ".next-citation-reading-build/types/**/*.ts",
    ".next-citation-reading-build/dev/types/**/*.ts",
    ".next-dossier-research-first-build/types/**/*.ts",
    ".next-dossier-research-first-build/dev/types/**/*.ts",
    ".next-dossier-research-first-dev/types/**/*.ts",
    ".next-dossier-research-first-dev/dev/types/**/*.ts",
    ".next-astra-build/types/**/*.ts",
    ".next-astra-build/dev/types/**/*.ts",
    ".next-astra-dev/types/**/*.ts",
    ".next-astra-dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts"
  ]
}
