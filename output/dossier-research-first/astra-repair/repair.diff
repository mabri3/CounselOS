+def date_anchors(run, metadata):
+    """Resolve dates from frozen facts and literal passages, not model claims."""
+    inputs = ((run.get("frozen_context") or {}).get("research_inputs") or {}).get("issue_inputs") or {}
+    anchors = {}
+    candidates = [(f.get("fact_id"), f.get("text", ""), f.get("date_role", "reported event")) for f in inputs.get("facts", [])]
+    for source in metadata.get("source_records") or []:
