+        candidates.append((source.get("source_id"), text, "source event"))
+    for rid, text, role in candidates:
+        dates = set(re.findall(r"\b\d{4}-\d{2}-\d{2}\b", text))
+        if rid and len(dates) == 1:
+            anchors[rid] = {"date": next(iter(dates)), "role": role}
+    return anchors
 
 
