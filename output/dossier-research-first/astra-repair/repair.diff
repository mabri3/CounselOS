+def source_coverage(sources):
+    """Count distinct external source versions from saved evidence only."""
+    found, retrieved, read = set(), set(), set()
+    for source in sources:
+        if not isinstance(source, dict) or source.get("source_type") == "workspace" or source.get("source_class") in {"reported_fact", "generated_assumption", "open_question", "saved_artifact", "recorded_decision", "supplied_source"} or source.get("support_state") == "supplied":
+            continue
+        sid = source.get("source_id") or source.get("url") or source.get("path")
+        if not sid:
+            continue
+        key = (sid, source.get("source_version") or source.get("source_hash") or source.get("path"))
+        found.add(key)
+        if source.get("support_state") in {"retrieved", "verified"} and not source.get("snapshot_error"):
+            retrieved.add(key)
+            if any(isinstance(p, dict) and str(p.get("text") or p.get("quote") or "").strip() for p in source.get("selected_passages") or []):
+                read.add(key)
+    return {"sources_discovered": len(found), "sources_retrieved": len(retrieved), "sources_read": len(read),
+            "support": f"{len(retrieved)} sources retrieved; {len(read)} with passages read" if found else "No external sources retrieved"}
