<script>
(function() {
  'use strict';

  
  var POPUP_ENABLED = true;
  var MOBILE_DELAY  = 30 * 1000;
  var FORM_ID       = "0155fae3-d4a2-4617-9f82-e878026860e3";
  var PORTAL_ID     = '48102731';
  var STORAGE_KEY   = 'turley_exit_popup_ts';
  var COOLDOWN_DAYS = 7;

  if (!POPUP_ENABLED) return;

  
  if (window.location.href.indexOf('hs_preview') > -1) return;
  if (document.querySelector('html').classList.contains('hs-inline-edit')) return;

  
  try {
    var lastShown = localStorage.getItem(STORAGE_KEY);
    if (lastShown) {
      var daysSince = (Date.now() - parseInt(lastShown, 10)) / (1000 * 60 * 60 * 24);
      if (daysSince < COOLDOWN_DAYS) return;
    }
  } catch(e) {}

  var overlay    = document.getElementById('exitPopup');
  var closeBtn   = document.getElementById('exitPopupClose');
  var isOpen     = false;
  var hasTriggered = false;
  var mobileTimer  = null;
  var focusTrap    = null;
  var previousFocus = null;

  if (!overlay || !closeBtn) return;

  
  function showPopup() {
    if (hasTriggered || isOpen) return;
    hasTriggered = true;
    isOpen = true;

    
    try {
      localStorage.setItem(STORAGE_KEY, Date.now().toString());
    } catch(e) {}

    
    previousFocus = document.activeElement;

    
    overlay.classList.add('is-fading-in');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    
    void overlay.offsetHeight;

    overlay.classList.remove('is-fading-in');
    overlay.classList.add('is-visible');

    
    if (FORM_ID && typeof hbspt !== 'undefined') {
      hbspt.forms.create({
        portalId: PORTAL_ID,
        formId: FORM_ID,
        target: '#exitPopupFormTarget',
        onFormSubmitted: function() {
          
          setTimeout(function() {
            closePopup();
          }, 3000);
        }
      });
    }

    
    setTimeout(function() {
      closeBtn.focus();
    }, 100);

    
    setupFocusTrap();
  }

  
  function closePopup() {
    if (!isOpen) return;
    isOpen = false;

    overlay.classList.remove('is-visible');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';

    
    if (focusTrap) {
      document.removeEventListener('keydown', focusTrap);
      focusTrap = null;
    }

    
    if (previousFocus && typeof previousFocus.focus === 'function') {
      previousFocus.focus();
    }
  }

  
  function setupFocusTrap() {
    focusTrap = function(e) {
      if (e.key === 'Escape' || e.keyCode === 27) {
        closePopup();
        return;
      }

      if (e.key !== 'Tab' && e.keyCode !== 9) return;

      var card = overlay.querySelector('.exit-popup-card');
      var focusable = card.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );

      if (focusable.length === 0) return;

      var firstEl = focusable[0];
      var lastEl  = focusable[focusable.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === firstEl) {
          e.preventDefault();
          lastEl.focus();
        }
      } else {
        if (document.activeElement === lastEl) {
          e.preventDefault();
          firstEl.focus();
        }
      }
    };

    document.addEventListener('keydown', focusTrap);
  }

  
  closeBtn.addEventListener('click', closePopup);

  
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) {
      closePopup();
    }
  });

  
  function isMobile() {
    return /Android|iPhone|iPad|iPod|Opera Mini|IEMobile|WPDesktop/i.test(navigator.userAgent)
      || ('ontouchstart' in window && window.innerWidth < 1024);
  }

  if (!isMobile()) {
    document.addEventListener('mouseleave', function(e) {
      
      if (e.clientY <= 0) {
        showPopup();
      }
    });
  } else {
    
    var resetMobileTimer = function() {
      if (hasTriggered) return;
      clearTimeout(mobileTimer);
      mobileTimer = setTimeout(showPopup, MOBILE_DELAY);
    };

    
    ['scroll', 'touchstart', 'touchmove', 'click'].forEach(function(evt) {
      document.addEventListener(evt, resetMobileTimer, { passive: true });
    });

    
    mobileTimer = setTimeout(showPopup, MOBILE_DELAY);
  }
})();
</script>

</div>

    
