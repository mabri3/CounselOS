<script>
jQuery(function ($) {

  $('.sh-sticky-sidebar-column').each(function () {

    var $column = $(this);
    var $sidebar = $column.find('> .elementor-widget-wrap > .elementor-widget').first();

    if (!$sidebar.length) return;

    var $wrap = $sidebar.parent();
    var $boundary = $column.closest('.elementor-section');

    if (!$boundary.length) {
      $boundary = $column.closest('.elementor-container');
    }

    if (!$boundary.length) {
      $boundary = $column.parent();
    }

    var topOffset = 100;
    var breakpoint = 1025;

    var $placeholder = $('<div class="sh-sticky-sidebar-placeholder"></div>');
    $sidebar.before($placeholder);

    $column.css({
      position: 'relative',
      overflow: 'visible'
    });

    $wrap.css({
      position: 'relative',
      overflow: 'visible'
    });

    function resetSidebar() {
      $placeholder.hide().css({
        height: 0,
        width: ''
      });

      $sidebar.css({
        position: '',
        top: '',
        left: '',
        width: '',
        maxWidth: '',
        zIndex: '',
        bottom: '',
        transform: ''
      });
    }

    function getNaturalMetrics() {
      $sidebar.css({
        position: 'relative',
        top: '',
        left: '',
        width: '',
        maxWidth: '',
        zIndex: ''
      });

      var width = $sidebar.outerWidth();
      var height = $sidebar.outerHeight(true);

      $placeholder.css({
        display: 'block',
        visibility: 'hidden',
        height: height + 'px',
        width: width + 'px'
      });

      var rect = $placeholder[0].getBoundingClientRect();

      return {
        width: width,
        height: height,
        left: rect.left
      };
    }

    function updateStickySidebar() {

      if ($(window).width() < breakpoint) {
        resetSidebar();
        return;
      }

      var scrollTop = $(window).scrollTop();
      var metrics = getNaturalMetrics();

      var columnTop = $column.offset().top;
      var boundaryTop = $boundary.offset().top;
      var boundaryHeight = $boundary.outerHeight();

      var startPoint = columnTop - topOffset;
      var endPoint = boundaryTop + boundaryHeight - metrics.height - topOffset;

      $placeholder.css({
        height: metrics.height + 'px',
        width: metrics.width + 'px'
      });

      if (scrollTop < startPoint) {

        $placeholder.hide();

        $sidebar.css({
          position: 'relative',
          top: '0',
          left: '0',
          width: metrics.width + 'px',
          maxWidth: metrics.width + 'px',
          zIndex: '20',
          boxSizing: 'border-box'
        });

      } else if (scrollTop >= startPoint && scrollTop <= endPoint) {

        $placeholder.css({
          display: 'block',
          visibility: 'hidden'
        });

        var liveLeft = $placeholder[0].getBoundingClientRect().left;

        $sidebar.css({
          position: 'fixed',
          top: topOffset + 'px',
          left: liveLeft + 'px',
          width: metrics.width + 'px',
          maxWidth: metrics.width + 'px',
          zIndex: '999',
          boxSizing: 'border-box'
        });

      } else {

        $placeholder.css({
          display: 'block',
          visibility: 'hidden'
        });

        var absoluteTop = boundaryTop + boundaryHeight - metrics.height - columnTop;
        var relativeLeft = $placeholder.position().left;

        $sidebar.css({
          position: 'absolute',
          top: absoluteTop + 'px',
          left: relativeLeft + 'px',
          width: metrics.width + 'px',
          maxWidth: metrics.width + 'px',
          zIndex: '20',
          boxSizing: 'border-box'
        });
      }
    }

    var ticking = false;

    function requestTick() {
      if (!ticking) {
        window.requestAnimationFrame(function () {
          updateStickySidebar();
          ticking = false;
        });
        ticking = true;
      }
    }

    $(window).on('scroll resize', requestTick);
    $(window).on('load', updateStickySidebar);

    $sidebar.find('img').on('load', updateStickySidebar);

    updateStickySidebar();

  });

});
</script>
	</body>
</html>

