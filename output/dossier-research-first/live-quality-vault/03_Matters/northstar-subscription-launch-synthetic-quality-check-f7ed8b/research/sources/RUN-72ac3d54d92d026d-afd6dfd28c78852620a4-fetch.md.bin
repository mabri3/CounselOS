<!DOCTYPE html>
<html lang='en'>
<head>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    (async function () {
      const faroWebSdkAppBasicConfig = {"url":"https://faro-collector-prod-us-east-0.grafana.net/collect/9eb1962ec60622b5f60d6170f88dd0f6","app":{"name":"BLAW-RAILS","version":"main","environment":"blaw-ui-prod-outside-blaw-rails"},"defaultAttributes":{"business_unit":"BLAW","confidentiality":"restricted"},"user":{"attributes":{"uuid":"3539131","firm_id":"135188","observability_gem_version":"0.5.7"}}};
  
      // load faro config from 
      var webSdkScript = document.createElement("script");
  
      // fetch the latest version of the Web-SDK from the CDN
      webSdkScript.src = "https://unpkg.com/@grafana/faro-web-sdk@^2.7.1/dist/bundle/faro-web-sdk.iife.js"; 
  
      webSdkScript.onload = async () => {
        window.GrafanaFaroWebSdk.initializeFaro({
          ...faroWebSdkAppBasicConfig,
          instrumentations: [
            ...window.GrafanaFaroWebSdk.getWebInstrumentations(),
          ],
          consoleInstrumentation: {
            serializeErrors: true,
            captureConsoleDisabledLevels: [
              window.GrafanaFaroWebSdk.LogLevel.DEBUG,
              window.GrafanaFaroWebSdk.LogLevel.TRACE,
              window.GrafanaFaroWebSdk.LogLevel.INFO,
              window.GrafanaFaroWebSdk.LogLevel.WARN,
              window.GrafanaFaroWebSdk.LogLevel.LOG,
            ],
          },
        });
  
        // Load instrumentations at the onLoad event of the web-SDK and after the above configuration.
        // This is important because we need to ensure that the Web-SDK has been loaded and initialized before we add further instruments!
        var webTracingScript = document.createElement("script");
  
        // fetch the latest version of the Web Tracing package from the CDN
        webTracingScript.src = "https://unpkg.com/@grafana/faro-web-tracing@^2.7.1/dist/bundle/faro-web-tracing.iife.js";
  
        // Initialize, configure (if necessary) and add the the new instrumentation to the already loaded and configured Web-SDK.
        webTracingScript.onload = () => {
          window.GrafanaFaroWebSdk.faro.instrumentations.add(
            new window.GrafanaFaroWebTracing.TracingInstrumentation({
              resourceAttributes: {
                  "deployment.environment": "{{ $environment }}",
                  "deployment_environment": "{{ $environment }}",
                  "deployment.environment.name": "{{ $environment }}",
              }
            })
          );
        };
  
        // Append the Web Tracing script script tag to the HTML page
        await document.head.appendChild(webTracingScript);
      };
  
      // Append the Web-SDK script script tag to the HTML page
      await document.head.appendChild(webSdkScript);
    })();
  })
</script>


