+.page {
+  display: grid;
+  gap: 16px;
+  max-width: var(--content-wide);
+}
+
+.pageHeader {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 16px 18px;
+  border: 1px solid var(--line);
+  border-left: 4px solid var(--agent);
+  border-radius: var(--radius);
+  background: var(--raised);
+}
+
+.backLink {
+  display: inline-flex;
+  min-height: 36px;
+  align-items: center;
+  font: 500 15px/1.5 var(--sans);
+  color: var(--ink-2);
+}
+
+.pageKicker,
+.meta {
+  display: block;
+  color: var(--ink-4);
+  font: 500 12px/1.4 var(--sans);
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.pageTitle {
+  margin: 4px 0 0;
+  font: 600 30px/1.16 var(--serif);
+}
+
+.questionDisclosure {
+  margin-top: 8px;
+  max-width: 74ch;
+}
+
+.questionDisclosure > summary,
