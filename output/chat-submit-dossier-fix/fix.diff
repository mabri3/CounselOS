+def restore_dossier_cards(app, matter_id, conversation):
+    """Restore controls omitted by older scenario filtering, from saved receipts.
+
+    This is a display projection. It neither reruns preparation nor changes the
+    transcript, and only uses a request saved for this exact conversation.
+    """
+    for message in conversation.get("messages", []):
+        if message.get("role") != "assistant":
+            continue
+        cards = message.setdefault("cards", [])
+        known = {card.get("request_id") for card in cards if card.get("type") == "dossier_research"}
+        for result in message.get("operation_results", []):
+            if result.get("operation") != "prepare_dossier_research" or result.get("status") not in {"changed", "no_change"}:
+                continue
+            for ref in result.get("entity_refs", []):
+                request_id = ref.get("id")
+                if ref.get("type") != "dossier_request" or not request_id or request_id in known:
+                    continue
+                try:
+                    status = app.dossier_requests.get(matter_id, request_id)
+                except (KeyError, OSError, ValueError):
+                    continue
+                if (status.get("origin") or {}).get("conversation_id") != conversation["conversation_id"]:
+                    continue
+                cards.append(DossierResearchCard(request_id=request_id, matter_id=matter_id,
+                    state=status["state"], phase=status["phase"], status=status,
+                    presentation="setup" if status["phase"] == "setup" else "progress").model_dump(mode="json"))
+                known.add(request_id)
+    return conversation
 
 
