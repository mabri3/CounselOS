+            # instead so that a later intake turn cannot erase that map.
+            values = _clean_text_list(self._issue_label(str(item)) for item in incoming)
+            return values, "# Issues and workstreams\n\n" + (
+                "\n".join(f"- {item}" for item in values) or "No workstreams identified yet."
+            ) + "\n"
+        keys = {_text_key(item) for item in existing}
+        additions: list[str] = []
+        for item in incoming:
+            text = self._issue_label(str(item)).strip()
+            if not text or _text_key(text) in keys:
+                continue
+            additions.append(text)
+            keys.add(_text_key(text))
+        if additions:
+            suffix = "\n" if content.endswith("\n") else "\n\n"
+            content = content.rstrip() + suffix + "\n".join(
+                f"- {item}" for item in additions
+            ) + "\n"
+        return [*existing, *additions], content
 
