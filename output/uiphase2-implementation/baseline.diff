+    def _write_template_snapshot(self, template: OutputTemplate) -> str:
+        safe_revision = re.sub(r"[^a-zA-Z0-9._-]+", "-", template.revision)
+        path = f"{TEMPLATE_HISTORY_ROOT}/{template.template_id}/{safe_revision}.md"
