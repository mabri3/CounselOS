{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "counsel-os-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "counsel-os-backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--port", "8000", "--app-dir", "backend"],
      "port": 8000
    }
  ]
}
